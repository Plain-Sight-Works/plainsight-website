---
interface Props {
  label: string;
  tone?: "light" | "dark";
  class?: string;
}

const { label, tone = "light", class: className } = Astro.props;
---

<figure
  aria-hidden="true"
  class:list={[
    "m-0 overflow-hidden rounded-2xl border shadow-card-hover select-none",
    tone === "dark" ? "border-border bg-surface" : "border-border-alt bg-bg",
    className,
  ]}
>
  <div class:list={["flex items-center justify-between gap-3 border-b px-5 py-3", tone === "dark" ? "border-border" : "border-border-alt"]}>
    <span class="text-15 font-bold tracking-snug text-text">{label}</span>
    <span class="font-mono text-label text-text-dim max-sm:hidden">dashboard.plainsight.works</span>
  </div>
  <div class="p-5 max-sm:p-4">
    <slot />
  </div>
</figure>
