---
import MockWindow from "./MockWindow.astro";

const stages = [
  { name: "Deposit", amount: "$1,500", note: "Paid Sep 2", state: "paid" },
  { name: "Design", amount: "$1,500", note: "Paid Sep 19", state: "paid" },
  { name: "Build", amount: "$2,000", note: "Ready for your review", state: "due" },
  { name: "Launch", amount: "$1,000", note: "Due at launch", state: "upcoming" },
];
---

<MockWindow label="Payment schedule">
  <ol class="flex flex-col">
    {stages.map((s) => (
      <li class:list={["flex flex-wrap items-center gap-x-4 gap-y-2 py-3", s.state === "due" ? "-mx-3 rounded-lg bg-accent-subtle px-3" : "border-b border-border-alt last:border-b-0"]}>
        <span class:list={["flex size-6 shrink-0 items-center justify-center rounded-full",
          s.state === "paid" ? "bg-accent text-btn-text" : s.state === "due" ? "border-2 border-accent" : "border border-border-alt"]}>
          {s.state === "paid" && (
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
          )}
        </span>
        <div class="min-w-0 flex-1">
          <div class="text-15 font-bold text-text">{s.name}</div>
          <div class:list={["text-13", s.state === "due" ? "font-semibold text-primary" : "text-text-dim"]}>{s.note}</div>
        </div>
        <span class="text-15 font-semibold text-text tabular-nums">{s.amount}</span>
        {s.state === "due" && (
          <span class="w-full rounded-lg bg-accent px-4 py-2 text-center text-15 font-semibold text-btn-text">Approve payment</span>
        )}
      </li>
    ))}
  </ol>
  <div class="mt-4 flex gap-4 border-t border-border-alt pt-4 text-13 font-semibold text-primary">
    <span>Receipts</span>
    <span>Invoices</span>
  </div>
</MockWindow>
