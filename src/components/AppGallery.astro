---
import { Image } from "astro:assets";

interface Props {
  items: { image: ImageMetadata; caption: string }[];
}

const { items } = Astro.props;
---

<div class="grid grid-cols-3 max-md:grid-cols-1 gap-6 my-8">
  {items.map((item) => (
    <figure class="m-0">
      <div class="rounded-xl overflow-hidden border border-border">
        <Image src={item.image} alt={item.caption} class="w-full h-auto block" />
      </div>
      <figcaption class="text-13 text-text-dim leading-loose mt-2">{item.caption}</figcaption>
    </figure>
  ))}
</div>
