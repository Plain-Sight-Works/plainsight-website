---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import CTA from "../../components/CTA.astro";
import AppGallery from "../../components/AppGallery.astro";
import demiHero from "../../assets/case-studies/demi-hero.png";
import demiOrdering from "../../assets/case-studies/demi-ordering.png";
import demiPrep from "../../assets/case-studies/demi-prep.png";
import surfsmashIcon from "../../assets/case-studies/surfsmash-icon.png";
import surfsmashHero from "../../assets/case-studies/surfsmash-website-hero.png";
import surfsmashAppHome from "../../assets/case-studies/app-home.png";
import surfsmashAppLive from "../../assets/case-studies/app-live-event.png";
import surfsmashAppCard from "../../assets/case-studies/app-athlete-card.png";
import surfsmashSchedule from "../../assets/case-studies/surfsmash-schedule.png";
import crtcHero from "../../assets/case-studies/crtc-home-hero.png";
import crtcBeforeFooter from "../../assets/case-studies/crtc-before-footer-ia.png";
import crtcWhatWeTreat from "../../assets/case-studies/crtc-what-we-treat-hub.png";
import crtcCondition from "../../assets/case-studies/crtc-condition-alcohol.png";
import crtcRiverside from "../../assets/case-studies/crtc-riverside.png";
import crtcEsHome from "../../assets/case-studies/crtc-es-home.png";
import crtcTestimonials from "../../assets/case-studies/crtc-testimonials.png";
import templetonHero from "../../assets/case-studies/templeton-home-hero.png";
import templetonBeforeHome from "../../assets/case-studies/templeton-before-home.png";
import templetonFloorplans from "../../assets/case-studies/templeton-floorplans.png";
import templetonFeatures from "../../assets/case-studies/templeton-features.png";
import templetonNeighbourhood from "../../assets/case-studies/templeton-neighbourhood.png";
import templetonBeforeNeighbourhood from "../../assets/case-studies/templeton-before-neighbourhood.png";
import templetonBeforeMobile from "../../assets/case-studies/templeton-before-mobile.png";
import templetonAfterMobile from "../../assets/case-studies/templeton-after-mobile.png";

export async function getStaticPaths() {
  const projects = await getCollection("work");
  return projects.map((project) => ({
    params: { slug: project.id.replace(/^\d+-/, '').replace(/\.md$/, '') },
    props: { project },
  }));
}

const { project } = Astro.props;
const d = project.data;

// One slug-keyed manifest of named images per case study. Add new case
// studies here by their slug; gallery/build blocks reference these keys.
const images: Record<string, Record<string, ImageMetadata>> = {
  demi: { hero: demiHero, approach: demiPrep, solution: demiOrdering },
  surfsmash: {
    icon: surfsmashIcon,
    hero: surfsmashHero,
    "app-home": surfsmashAppHome,
    "app-live-event": surfsmashAppLive,
    "app-athlete-card": surfsmashAppCard,
    schedule: surfsmashSchedule,
  },
  crtc: {
    hero: crtcHero,
    "before-footer-ia": crtcBeforeFooter,
    "what-we-treat-hub": crtcWhatWeTreat,
    "condition-alcohol": crtcCondition,
    riverside: crtcRiverside,
    "es-home": crtcEsHome,
    testimonials: crtcTestimonials,
  },
  templeton: {
    hero: templetonHero,
    "before-home": templetonBeforeHome,
    floorplans: templetonFloorplans,
    features: templetonFeatures,
    neighbourhood: templetonNeighbourhood,
    "before-neighbourhood": templetonBeforeNeighbourhood,
    "before-mobile": templetonBeforeMobile,
    "after-mobile": templetonAfterMobile,
  },
};

const slug = project.id.replace(/^\d+-/, '').replace(/\.md$/, '');
const img = images[slug] ?? {};
const heroImage = img.hero;
const approachImage = img.approach;
const solutionImage = img.solution;
const isAlt = d.order % 2 === 0;

// Approach and solution copy may hold multiple paragraphs separated by blank lines.
const approachParas = (d.approach ?? '').split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);
const solutionParas = (d.solution ?? '').split(/\n{2,}/).map((p) => p.trim()).filter(Boolean);

// Rich layout (overview / what we built / under the hood / at a glance /
// outcome) renders when `build` is present; otherwise the Demi-style
// challenge / approach / solution / results layout renders.
const isRich = !!d.build;

const heroLinks = [
  { label: `Visit ${d.url.replace(/^https?:\/\//, '').replace(/\/$/, '')}`, url: d.url },
  ...(d.links ?? []),
].filter((link) => link.url && link.url !== '#');
---

<Base title={`${d.title} | Plain Sight`} description={d.challenge}>
  <main class="container pt-22 max-md:pt-16">
    <a href="/work" class="back-link">← All Projects</a>

    <article class="project-article">
      {d.icon && img[d.icon] && (
        <Image src={img[d.icon]} alt={`${d.title} app icon`} width={72} height={72} class="rounded-2xl border border-border mb-6 block" />
      )}
      <h1 class="font-heading text-page-hero font-black tracking-tighter leading-snug mb-5">{d.title}</h1>
      <p class={`text-section-subtitle text-text-muted leading-loose max-w-[960px] ${isRich ? 'mb-6' : 'mb-12'}`}>{d.subtitle}</p>

      {isRich && (
        <div class="flex flex-wrap items-center gap-x-6 gap-y-3 mb-12">
          {d.tags && d.tags.length > 0 && (
            <div class="flex flex-wrap gap-2">
              {d.tags.map((tag) => (
                <span class="border border-border rounded-full px-3 py-0.5 text-13 uppercase tracking-wider text-text-muted">{tag}</span>
              ))}
            </div>
          )}
          <div class="flex flex-wrap gap-x-6 gap-y-2">
            {heroLinks.map((link) => (
              <a href={link.url} target="_blank" rel="noopener noreferrer" class="text-accent text-15 font-semibold hover:underline inline-flex items-center gap-1.5">
                {link.label}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <polyline points="15 3 21 3 21 9"></polyline>
                  <line x1="10" y1="14" x2="21" y2="3"></line>
                </svg>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="mb-20 rounded-xl overflow-hidden border border-border">
        {heroImage ? (
          <Image src={heroImage} alt={d.title} width={1100} class="w-full h-auto block" />
        ) : (
          <div class={`aspect-hero ${isAlt ? 'bg-surface' : 'bg-surface-raised'} border-2 border-dashed border-border rounded-xl flex items-center justify-center`}>
            <span class="text-text-dim text-[0.9rem]">Hero image</span>
          </div>
        )}
      </div>

      {isRich ? (
        <>
          {d.overview && (
            <section class="mb-20">
              <h2 class="text-case-study-title font-extrabold mb-6 text-text tracking-tight">The game</h2>
              <p class="text-section-prose text-text-muted leading-extra-loose">{d.overview}</p>
            </section>
          )}

          <section class="mb-20">
            <h2 class="text-case-study-title font-extrabold mb-6 text-text tracking-tight">What made it interesting</h2>
            <p class="text-section-prose text-text-muted leading-extra-loose">{d.challenge}</p>
          </section>

          {d.build && (
            <section class="mb-20">
              <h2 class="text-case-study-title font-extrabold mb-8 text-text tracking-tight">What we built</h2>
              {d.build.map((block) => {
                const hasSingleImage = block.image && img[block.image];
                return (
                  <div class="mb-14 last:mb-0">
                    {hasSingleImage ? (
                      <div class="md:flow-root">
                        <figure class="m-0 max-md:mb-6 md:float-right md:w-[42%] md:ml-10 md:mb-2">
                          <div class="rounded-xl overflow-hidden border border-border">
                            <Image src={img[block.image]} alt={block.imageCaption ?? block.heading} class="w-full h-auto block" />
                          </div>
                          {block.imageCaption && (
                            <figcaption class="text-13 text-text-dim leading-loose mt-2">{block.imageCaption}</figcaption>
                          )}
                        </figure>
                        <h3 class="text-item-title font-bold mb-4 text-text tracking-snug">{block.heading}</h3>
                        <p class="text-section-prose text-text-muted leading-extra-loose">{block.body}</p>
                      </div>
                    ) : (
                      <>
                        <h3 class="text-item-title font-bold mb-4 text-text tracking-snug">{block.heading}</h3>
                        <p class="text-section-prose text-text-muted leading-extra-loose">{block.body}</p>
                        {block.gallery && (
                          <AppGallery items={block.gallery.map((g) => ({ image: img[g.image], caption: g.caption }))} />
                        )}
                      </>
                    )}
                  </div>
                );
              })}
            </section>
          )}

          {d.techNarrative && (
            <section class="mb-20">
              <h2 class="text-case-study-title font-extrabold mb-6 text-text tracking-tight">Under the hood</h2>
              <p class="text-section-prose text-text-muted leading-extra-loose">{d.techNarrative}</p>
            </section>
          )}

          {d.facts && (
            <section class="mb-20">
              <h2 class="text-case-study-title font-extrabold mb-6 text-text tracking-tight">At a glance</h2>
              <div class="bg-surface border border-border rounded-xl p-6">
                <div class="grid grid-cols-2 max-md:grid-cols-1 gap-6">
                  {d.facts.map((fact) => (
                    <div>
                      <span class="block text-13 uppercase tracking-wider text-text-dim mb-1">{fact.label}</span>
                      <span class="font-semibold text-text text-17">{fact.value}</span>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )}

          {d.outcome && (
            <section class="mb-20">
              <h2 class="text-case-study-title font-extrabold mb-6 text-text tracking-tight">Where it landed</h2>
              <p class="text-section-prose text-text-muted leading-extra-loose">{d.outcome}</p>
            </section>
          )}
        </>
      ) : (
        <>
          <section class="grid grid-cols-[2fr_1fr] max-md:grid-cols-1 gap-12 mb-20 items-start">
            <div>
              <h2 class="text-case-study-title font-extrabold mb-6 text-text tracking-tight">Client Challenge</h2>
              <p class="text-section-prose text-text-muted leading-extra-loose">{d.challenge}</p>
            </div>
            <div class="bg-surface border border-border rounded-xl p-6">
              <div class="mb-5">
                <span class="font-semibold text-15 text-text block mb-1">Tech Stack</span>
                <span class="text-text-muted text-17">{d.tech}</span>
              </div>
              {d.facts && d.facts.map((fact) => (
                <div class="mb-5">
                  <span class="font-semibold text-15 text-text block mb-1">{fact.label}</span>
                  <span class="text-text-muted text-17">{fact.value}</span>
                </div>
              ))}
              <div>
                <span class="font-semibold text-15 text-text block mb-1">Visit Site</span>
                <a href={d.url} target="_blank" rel="noopener noreferrer" class="text-accent text-17 hover:underline break-all inline-flex items-center gap-1.5">
                  {d.url?.replace('https://', '') || d.url || 'N/A'}
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </div>
            </div>
          </section>

          {d.beforeAfter && (
            <section class="grid grid-cols-2 max-md:grid-cols-1 gap-8 mb-20">
              <figure class="m-0">
                <span class="inline-block text-13 uppercase tracking-wider font-semibold text-tertiary border border-border rounded-full px-3 py-0.5 mb-3">Before</span>
                <div class="rounded-xl overflow-hidden border border-border">
                  <Image src={img[d.beforeAfter.before.image]} alt={d.beforeAfter.before.caption} class="w-full h-auto block" />
                </div>
                <figcaption class="text-13 text-text-dim leading-loose mt-2">{d.beforeAfter.before.caption}</figcaption>
              </figure>
              <figure class="m-0">
                <span class="inline-block text-13 uppercase tracking-wider font-semibold text-accent border border-border rounded-full px-3 py-0.5 mb-3">After</span>
                <div class="rounded-xl overflow-hidden border border-border">
                  <Image src={img[d.beforeAfter.after.image]} alt={d.beforeAfter.after.caption} class="w-full h-auto block" />
                </div>
                <figcaption class="text-13 text-text-dim leading-loose mt-2">{d.beforeAfter.after.caption}</figcaption>
              </figure>
            </section>
          )}

          {approachImage ? (
            <section class="grid grid-cols-[1fr_1.2fr] max-md:grid-cols-1 gap-12 mb-20 items-start">
              <div class="rounded-xl overflow-hidden max-md:order-2">
                <Image src={approachImage} alt={`${d.title} strategic approach`} class="w-full h-auto" />
              </div>
              <div class="max-md:order-1">
                <h2 class="text-case-study-title font-extrabold mb-6 text-text tracking-tight">Our strategic approach</h2>
                {approachParas.map((para, i) => (
                  <p class={`text-section-prose text-text-muted leading-extra-loose ${i > 0 ? 'mt-6' : ''}`}>{para}</p>
                ))}
              </div>
            </section>
          ) : (
            <section class="mb-20">
              <h2 class="text-case-study-title font-extrabold mb-6 text-text tracking-tight">Our strategic approach</h2>
              {approachParas.map((para, i) => (
                <p class={`text-section-prose text-text-muted leading-extra-loose max-w-[800px] ${i > 0 ? 'mt-6' : ''}`}>{para}</p>
              ))}
            </section>
          )}

          {solutionImage ? (
            <section class="grid grid-cols-[1.2fr_1fr] max-md:grid-cols-1 gap-12 mb-20 items-start">
              <div>
                <h2 class="text-case-study-title font-extrabold mb-6 text-text tracking-tight">Solution</h2>
                {solutionParas.map((para, i) => (
                  <p class={`text-section-prose text-text-muted leading-extra-loose ${i > 0 ? 'mt-6' : ''}`}>{para}</p>
                ))}
              </div>
              <div class="rounded-xl overflow-hidden">
                <Image src={solutionImage} alt={`${d.title} solution`} class="w-full h-auto" />
              </div>
            </section>
          ) : (
            <section class="mb-20">
              <h2 class="text-case-study-title font-extrabold mb-6 text-text tracking-tight">Solution</h2>
              {solutionParas.map((para, i) => (
                <p class={`text-section-prose text-text-muted leading-extra-loose max-w-[800px] ${i > 0 ? 'mt-6' : ''}`}>{para}</p>
              ))}

              {d.solutionGallery && (
                <div class="grid grid-cols-2 max-md:grid-cols-1 gap-8 mt-10">
                  {d.solutionGallery.map((item) => (
                    <figure class="m-0">
                      <div class="rounded-xl overflow-hidden border border-border">
                        <Image src={img[item.image]} alt={item.caption} class="w-full h-auto block" />
                      </div>
                      <figcaption class="text-13 text-text-dim leading-loose mt-2">{item.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              )}

              {d.parity && (
                <div class="grid grid-cols-2 max-md:grid-cols-1 gap-8 mt-8">
                  {[d.parity.left, d.parity.right].map((side) => (
                    <figure class="m-0 flex flex-col items-center text-center">
                      <span class="inline-block text-13 uppercase tracking-wider font-semibold text-accent border border-border rounded-full px-3 py-0.5 mb-3">{side.label}</span>
                      <div class="rounded-xl overflow-hidden border border-border max-w-[280px]">
                        <Image src={img[side.image]} alt={side.caption} class="w-full h-auto block" />
                      </div>
                      <figcaption class="text-13 text-text-dim leading-loose mt-2 max-w-[280px]">{side.caption}</figcaption>
                    </figure>
                  ))}
                </div>
              )}

              {d.featureImage && (
                <figure class="m-0 mt-8">
                  <div class="rounded-xl overflow-hidden border border-border">
                    <Image src={img[d.featureImage.image]} alt={d.featureImage.caption} class="w-full h-auto block" />
                  </div>
                  <figcaption class="text-13 text-text-dim leading-loose mt-2">{d.featureImage.caption}</figcaption>
                </figure>
              )}
            </section>
          )}

          <section class="mb-20">
            <h2 class="text-case-study-title font-extrabold mb-6 text-text tracking-tight">Results</h2>
            <p class="text-section-prose text-text-muted leading-extra-loose max-w-[800px]">{d.results}</p>

            {d.resultsGallery && (
              <div class="grid grid-cols-2 max-md:grid-cols-1 gap-8 mt-10">
                {d.resultsGallery.map((item) => (
                  <figure class="m-0">
                    <div class="rounded-xl overflow-hidden border border-border">
                      <Image src={img[item.image]} alt={item.caption} class="w-full h-auto block" />
                    </div>
                    <figcaption class="text-13 text-text-dim leading-loose mt-2">{item.caption}</figcaption>
                  </figure>
                ))}
              </div>
            )}
          </section>
        </>
      )}
    </article>
  </main>

  <CTA heading="Your project could be next" ctaText="Reach out" ctaLink="/contact">
    <p>We're building this out one great project at a time. Curious if we're the right fit for what you're building?</p>
  </CTA>
</Base>

<style>
  .back-link {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    margin-bottom: 2rem;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .project-article {
    margin-bottom: 4rem;
  }
</style>
