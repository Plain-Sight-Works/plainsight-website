S---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import CaseStudyCard from "../components/CaseStudyCard.astro";
import CTA from "../components/CTA.astro";
import demiHero from "../assets/case-studies/demi-hero.png";
import surfsmashHero from "../assets/case-studies/surfsmash-website-hero.png";
import crtcHero from "../assets/case-studies/crtc-home-hero.png";

const projects = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order
);

const heroImages: Record<string, ImageMetadata> = {
  demi: demiHero,
  surfsmash: surfsmashHero,
  crtc: crtcHero,
};

const descriptions: Record<string, string> = {
  demi: "Complex AI kitchen software that needed to feel simple. We led with operator pain points, not tech jargon, and built a marketing site that makes Demi feel like relief, not another learning curve.",
  surfsmash: "A card-based fantasy game for the World Surf League season. We built the whole platform: the iOS and Android app, the admin tool that runs live scoring, and the launch site. Live now on the App Store and Google Play.",
  crtc: "An international addiction treatment center whose site had grown hard for families to navigate, with the same programs split across three overlapping sections and the case for trust scattered throughout. We rebuilt it around the decision a family is actually making, and gave it a warmer, more grounded design that feels as human as the care it describes.",
};

const caseStudies = projects.map((project) => {
  const slug = project.id.replace(/^\d+-/, '').replace(/\.md$/, '');
  return {
    title: project.data.title,
    description: descriptions[slug] ?? project.data.challenge,
    slug,
    image: heroImages[slug],
    tags: project.data.tags,
  };
});
---

<Base title="Work | Plain Sight | Vancouver Web Design and Development" description="Selected projects showing our strategic approach to web development.">
  <main class="container pt-22 max-md:pt-16 pb-40">
    <section class="py-14 max-md:py-10 relative overflow-hidden">
      <h1 class="text-page-hero font-black tracking-tighter leading-snug mb-5 relative">See for yourself</h1>
      <p class="text-page-subheading text-text-muted max-w-[960px] relative">Sites that look great and drive results for the businesses behind them</p>
    </section>

    <div class="grid grid-cols-2 max-md:grid-cols-1 gap-12 mb-8 max-md:[&>*:not(:last-child)]:border-b max-md:[&>*:not(:last-child)]:border-border max-md:[&>*:not(:last-child)]:pb-12">
      {caseStudies.map((study) => (
        <CaseStudyCard
          title={study.title}
          description={study.description}
          link={`/work/${study.slug}`}
          image={study.image}
          tags={study.tags}
        />
      ))}
    </div>
  </main>

  <CTA heading="Your project could be next" ctaText="Reach out" ctaLink="/contact">
    <p>We're building this out one great project at a time. Curious if we're the right fit for what you're building?</p>
  </CTA>
</Base>
